<Window x:Class="RemoteDesktop.UI.Views.ViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="遠端桌面" Width="1100" Height="720" MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI, Microsoft JhengHei UI" FontSize="13">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#F1F5F9" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="10,6">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="中斷連線" Click="OnDisconnect" Margin="8,0,0,0"
                        Background="#DC2626" Foreground="White" BorderThickness="0"/>
                <TextBlock x:Name="StatusText" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="{StaticResource Muted}"
                           Margin="12,0,0,0"/>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="GetClipboardButton" Content="取得對方剪貼簿" Click="OnGetClipboard"/>
                    <Button x:Name="SendClipboardButton" Content="傳送我的剪貼簿" Click="OnSendClipboard"/>
                    <Button x:Name="UploadButton" Content="上傳檔案" Click="OnUpload"/>
                    <Button x:Name="DownloadButton" Content="下載檔案" Click="OnDownload"/>
                    <TextBlock x:Name="Notice" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="{StaticResource Accent}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border x:Name="SecurityBar" DockPanel.Dock="Top" Padding="10,4" Background="#FEF3C7" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <DockPanel>
                <Button x:Name="VerifyButton" DockPanel.Dock="Right" Content="已核對,相同" Click="OnVerifyCode" Margin="8,0,0,0"
                        AutomationProperties.Name="已核對安全碼"/>
                <TextBlock x:Name="SecurityText" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </DockPanel>
        </Border>

        <Grid>
            <Border x:Name="Surface" Background="Black" Focusable="True" FocusVisualStyle="{x:Null}" Cursor="Arrow"
                    MouseMove="OnMouseMove" MouseDown="OnMouseDown" MouseUp="OnMouseUp" MouseWheel="OnMouseWheel">
                <Image x:Name="Screen" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>
            <TextBlock x:Name="WaitingText" Text="正在等待對方的畫面…" Foreground="#9CA3AF" FontSize="18"
                       HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
            <Border x:Name="ReconnectingBanner" Visibility="Collapsed" VerticalAlignment="Top" HorizontalAlignment="Center"
                    Margin="0,16,0,0" Padding="18,8" CornerRadius="6" Background="#E6B45309" IsHitTestVisible="False">
                <TextBlock x:Name="ReconnectingText" Foreground="White" FontSize="15" FontWeight="SemiBold"
                           AutomationProperties.Name="重新連線狀態"
                           Text="網路中斷,正在重新連線…(恢復後畫面會自動更新)"/>
            </Border>
            <Border x:Name="EndedOverlay" Visibility="Collapsed" Background="#CC000000">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="連線已結束" Foreground="White" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="EndedReason" Foreground="#D1D5DB" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                    <Button Content="關閉視窗" Click="OnDisconnect" Margin="0,16,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
