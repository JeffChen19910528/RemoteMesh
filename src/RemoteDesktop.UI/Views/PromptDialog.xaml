<Window x:Class="RemoteDesktop.UI.Views.PromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="420" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI, Microsoft JhengHei UI" FontSize="14">
    <StackPanel Margin="20">
        <TextBlock x:Name="Label" TextWrapping="Wrap"/>
        <TextBox x:Name="Input" Margin="0,8,0,16"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" IsCancel="True" Padding="20,6"/>
            <Button Content="確定" IsDefault="True" Click="OnOk" Margin="0" Padding="20,6"/>
        </StackPanel>
    </StackPanel>
</Window>
