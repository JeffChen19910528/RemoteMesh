{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Security": {
    "AllowInsecureTransport": false
  },

  "RemoteMesh": {
    "Session": {
      "ApprovalTimeout": "00:02:00",
      "MaxPendingRequestsPerTarget": 5,
      "MaxActiveSessionsPerDevice": 8,
      "MaxTotalActiveSessions": 10000,
      "FinishedSessionRetention": "01:00:00",
      "SessionRequestsPerMinute": 20,
      "UnknownDeviceLookupsPer10Min": 10,
      "RegistrationFailuresPerIpPer10Min": 10,
      "RegistrationFailuresPerConnection": 3,
      "RelayTokenLifetime": "00:02:00",
      "RelayTokenRequestsPerMinute": 10,
      "MaxCandidateJsonBytes": 4096,
      "MaxDeviceNameLength": 64,
      "MaxTrustedDevicesPerOwner": 200
    },
    "Recovery": {
      "Window": "00:01:00",
      "SweepInterval": "00:00:05",
      "MaxResumeAttemptsPerMinute": 10
    },
    "Relay": {
      "PeerWaitTimeout": "00:00:30",
      "IdleTimeout": "00:05:00",
      "MaxMessageBytes": 1048576,
      "MaxBytesPerSecond": 26214400,
      "ConnectionsPerMinutePerAddress": 60,
      "UnauthorizedAttemptsPerAddress": 10,
      "MaxConcurrentPairings": 10000
    }
  }
}
