{
  "Logging": {
    "LogLevel": { "Default": "Warning", "Microsoft.AspNetCore": "Warning" }
  },

  "RemoteMesh": {
    "Session": {
      "MaxTotalActiveSessions": 5000,
      "MaxActiveSessionsPerDevice": 4,
      "ApprovalTimeout": "00:01:30"
    },
    "Relay": {
      "MaxConcurrentPairings": 5000,
      "MaxBytesPerSecond": 13107200,
      "ConnectionsPerMinutePerAddress": 120
    },
    "Database": {
      "AuditRetentionDays": 90
    },
    "ForwardedHeaders": {
      "Enabled": true,
      "KnownProxies": [ "10.0.0.5" ]
    }
  }
}
