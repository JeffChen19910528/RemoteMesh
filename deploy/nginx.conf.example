# Reverse proxy for RemoteMesh: terminates TLS and forwards to the server on localhost.
# The matching server settings (see appsettings.Production.example.json):
#   RemoteMesh:ForwardedHeaders:Enabled = true
#   RemoteMesh:ForwardedHeaders:KnownProxies = [ "<address nginx connects from>" ]
# Without them the server sees every client as the proxy and rate limits would hit everyone at once.
#
# Do not log request headers: the relay token travels in X-Relay-Token. nginx's default access log
# does not include headers, and this configuration keeps it that way.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name relay.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name relay.example.com;

    ssl_certificate     /etc/ssl/remotemesh/fullchain.pem;
    ssl_certificate_key /etc/ssl/remotemesh/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=31536000" always;

    # Signaling (SignalR: WebSocket, with long-polling fallback) and the relay WebSocket.
    location ~ ^/(hubs|ws)/ {
        proxy_pass http://127.0.0.1:5222;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;   # overwrite, never append client-supplied values
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location = /health {
        proxy_pass http://127.0.0.1:5222;
    }

    # Everything else is not part of the product.
    location / { return 404; }
}
